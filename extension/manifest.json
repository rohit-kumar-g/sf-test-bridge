{
  "manifest_version": 3,
  "name": "SF Test Bridge",
  "version": "0.1.0",
  "description": "Lets Claude Code drive tabs in your real browser profile (SSO sessions included) through a local MCP server.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "storage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SF Test Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
