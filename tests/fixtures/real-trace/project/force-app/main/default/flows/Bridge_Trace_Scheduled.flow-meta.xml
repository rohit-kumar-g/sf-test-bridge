<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>SF Test Bridge capture fixture: schedule-triggered flow, runs once, only for the Account named Bridge Trace Acme.</description>
    <interviewLabel>Bridge Trace Scheduled {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Bridge Trace Scheduled</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Note_Scheduled</name>
        <label>Set Note Scheduled</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>acmens__Bridge_Trace_Note__c</field>
            <value><stringValue>Set by scheduled flow</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Rating</field>
            <value><stringValue>Warm</stringValue></value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Set_Note_Scheduled</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value><stringValue>Bridge Trace Acme</stringValue></value>
        </filters>
        <object>Account</object>
        <schedule>
            <frequency>Once</frequency>
            <startDate>2026-11-15</startDate>
            <startTime>03:06:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
